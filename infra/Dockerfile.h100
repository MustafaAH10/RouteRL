FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/mnt/hf \
    ROUTERL_ARTIFACT_ROOT=/mnt/routerl_artifacts

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/RouteRL
COPY . /opt/RouteRL

RUN python3.11 -m venv /opt/routerl \
    && /opt/routerl/bin/python -m pip install --upgrade pip setuptools wheel \
    && /opt/routerl/bin/python -m pip install -e . \
    && /opt/routerl/bin/python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124 \
    && /opt/routerl/bin/python -m pip install accelerate huggingface_hub qwen-vl-utils safetensors transformers pyarrow

ENV PATH="/opt/routerl/bin:${PATH}"

CMD ["bash", "scripts/smoke_h100_instance.sh"]
